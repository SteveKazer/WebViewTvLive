<resources xmlns:tools="http://schemas.android.com/tools">

	<style name="FullscreenTheme" parent="Theme.AppCompat.NoActionBar">
		<item name="windowNoTitle">true</item>
		<item name="android:windowFullscreen">true</item>
		<item name="android:windowBackground">@drawable/splash</item>
		<item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
	</style>

	<style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
		<item name="windowNoTitle">true</item>
		<item name="android:windowFullscreen">false</item>
		<item name="android:windowBackground">@drawable/splash</item>
	</style>

	<!-- 深色弹窗(更新提示/下载进度) -->
	<style name="DarkDialog" parent="Theme.AppCompat.Dialog.Alert">
		<item name="android:windowBackground">@drawable/bg_dialog</item>
		<item name="colorAccent">#F2B33D</item>
		<item name="android:textColorPrimary">#F2F4F7</item>
		<item name="android:textColorSecondary">#98A2B3</item>
		<item name="android:windowMinWidthMajor">45%</item>
		<item name="android:windowMinWidthMinor">75%</item>
	</style>

</resources>