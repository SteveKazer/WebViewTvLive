<?xml version="1.0" encoding="utf-8"?>
<merge
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:parentTag="android.widget.FrameLayout">

	<View
		android:id="@+id/sheetMask"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#A6000000" />

	<LinearLayout
		android:id="@+id/sheetCard"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_margin="16dp"
		android:background="@drawable/bg_sheet"
		android:orientation="horizontal">

		<!-- 左侧分类栏 -->
		<LinearLayout
			android:layout_width="118dp"
			android:layout_height="match_parent"
			android:background="@drawable/bg_sheet_side"
			android:orientation="vertical"
			android:paddingTop="14dp"
			android:paddingBottom="10dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingStart="14dp"
				android:paddingEnd="8dp"
				android:paddingBottom="10dp"
				android:text="频道列表"
				android:textColor="#FF8A93A3"
				android:textSize="12sp" />

			<TextView
				android:id="@+id/tabAll"
				style="@style/SheetCategory"
				android:text="全部" />

			<TextView
				android:id="@+id/tabCctv"
				style="@style/SheetCategory"
				android:text="央视" />

			<TextView
				android:id="@+id/tabWeishi"
				style="@style/SheetCategory"
				android:text="卫视" />

			<Space
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1" />

			<TextView
				android:id="@+id/tabFavorite"
				style="@style/SheetCategory"
				android:text="★ 收藏" />
		</LinearLayout>

		<!-- 右侧频道列表 -->
		<FrameLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:paddingStart="12dp"
				android:paddingTop="12dp"
				android:paddingEnd="12dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/listTitle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:singleLine="true"
					android:text="全部频道"
					android:textColor="#FFB8C0CC"
					android:textSize="12sp" />

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/listChannels"
					android:layout_width="match_parent"
					android:layout_height="0dp"
					android:layout_weight="1"
					android:layout_marginTop="8dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<TextView
				android:id="@+id/emptyHint"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center"
				android:lineSpacingExtra="6dp"
				android:text="收藏夹还是空的\n长按频道即可加入收藏"
				android:textColor="#FF7C8594"
				android:textSize="14sp"
				android:visibility="gone" />
		</FrameLayout>
	</LinearLayout>

	<!-- 清晰度入口(浮于右上角) -->
	<TextView
		android:id="@+id/btnQuality"
		android:layout_width="wrap_content"
		android:layout_height="34dp"
		android:layout_gravity="top|end"
		android:layout_marginTop="28dp"
		android:layout_marginEnd="30dp"
		android:background="@drawable/bg_item"
		android:focusable="true"
		android:gravity="center"
		android:paddingStart="14dp"
		android:paddingEnd="14dp"
		android:text="清晰度 蓝光"
		android:textColor="@color/color_text"
		android:textSize="13sp" />

</merge>