<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/mainLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context=".activity.MainActivity">

	<com.vasthread.webviewtv.widget.ChannelPlayerView
		android:id="@+id/player"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<com.vasthread.webviewtv.widget.UiLayout
		android:id="@+id/uiLayout"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<com.vasthread.webviewtv.widget.ChannelSheetView
			android:id="@+id/channelSheet"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<com.vasthread.webviewtv.widget.QualitySheetView
			android:id="@+id/qualitySheet"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<com.vasthread.webviewtv.widget.SettingsSheetView
			android:id="@+id/settingsSheet"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

	</com.vasthread.webviewtv.widget.UiLayout>

</FrameLayout>
